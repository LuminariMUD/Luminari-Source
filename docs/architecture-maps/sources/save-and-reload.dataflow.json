  "flows": [
    {
      "id": "zone-edits",
      "from": "world",
      "to": "genolc",
      "label": "zone edits",
      "variant": "default"
    },
    {
      "id": "atomic-write",
      "from": "genolc",
      "to": "worldfiles",
      "label": ".new + rename",
      "classification": "authored content",
      "variant": "emphasis"
    },
    {
      "id": "zone-files",
      "from": "worldfiles",
      "to": "indexboot",
      "label": "zone files",
      "variant": "default"
    },
    {
      "id": "prototypes",
      "from": "indexboot",
      "to": "nextboot",
      "label": "prototypes",
      "variant": "emphasis"
    },
    {
      "id": "player-state",
      "from": "chars",
      "to": "savechar",
      "label": "player state",
      "variant": "default",
      "fromSide": "top",
      "toSide": "left",
      "via": [
        [
          100,
          271
        ]
      ]
    },
    {
      "id": "plr-file",
      "from": "savechar",
      "to": "pfiles",
      "label": ".plr file",
      "variant": "emphasis"
    },
    {
      "id": "player-file",
      "from": "pfiles",
      "to": "loaders",
      "label": "load_char()",
      "variant": "default"
    },
    {
      "id": "items-pets",
      "from": "chars",
      "to": "sqlsaves",
      "label": "items, pets",
      "variant": "default"
    },
    {
      "id": "sql-rows",
      "from": "sqlsaves",
      "to": "mariadb",
      "label": "SQL rows",
      "variant": "emphasis"
    },
    {
      "id": "account-row",
      "from": "mariadb",
      "to": "loaders",
      "label": "account row",
      "classification": "password hash",
      "variant": "security",
      "fromSide": "right",
      "toSide": "bottom",
      "via": [
        [
          745,
          385
        ]
      ]
    },
    {
      "id": "restored",
      "from": "loaders",
      "to": "nextlogin",
      "label": "char_data",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "World content",
      "items": [
        "OLC writes .new, then renames",
        "index_boot() reloads at boot",
        "Regions and paths load from SQL"
      ]
    },
    {
      "dot": "rose",
      "title": "Player state",
      "items": [
        ".plr files hold character data",
        "Items, houses, pets live in SQL",
        "Accounts load before characters"
      ]
    },
    {
      "dot": "orange",
      "title": "Evidence",
      "items": [
        "genwld.c: save_rooms() at 497",
        "players.c: save_char_checked 2341",
        "objsave.c: player_save_objs 552"
      ]
    }
  ]
}
