{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "Save and Reload Data Flow",
    "locale": "en",
    "viewBox": [
      1080,
      540
    ],
    "animation": "trace",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "world-content",
        "label": "World content",
        "focus": [
          "world",
          "genolc",
          "worldfiles",
          "indexboot",
          "nextboot"
        ],
        "note": "Builders edit prototypes in OLC; writers replace zone files atomically and the next boot reloads them."
      },
      {
        "id": "characters",
        "label": "Characters",
        "focus": [
          "chars",
          "savechar",
          "pfiles",
          "loaders",
          "nextlogin"
        ],
        "note": "Character data round-trips through one player file per character."
      },
      {
        "id": "sql-state",
        "label": "SQL state",
        "focus": [
          "chars",
          "sqlsaves",
          "mariadb",
          "loaders"
        ],
        "note": "Accounts, stored items, houses, and pets live in MariaDB tables instead of player files."
      }
    ]
  },
  "stages": [
    {
      "label": "Live state"
    },
    {
      "label": "Writers"
    },
    {
      "label": "Durable stores"
    },
    {
      "label": "Loaders"
    },
    {
      "label": "Next session"
    }
  ],
  "nodes": [
    {
      "id": "world",
      "type": "database",
      "label": "World + Protos",
      "sublabel": "edited in OLC",
      "stage": 0,
      "row": 0
    },
    {
      "id": "chars",
      "type": "frontend",
      "label": "Characters",
      "sublabel": "char_data, gear",
      "stage": 0,
      "row": 2
    },
    {
      "id": "genolc",
      "type": "backend",
      "label": "OLC Writers",
      "sublabel": "gen*.c",
      "stage": 1,
      "row": 0
    },
    {
      "id": "savechar",
      "type": "backend",
      "label": "Player Saver",
      "sublabel": "players.c",
      "stage": 1,
      "row": 1
    },
    {
      "id": "sqlsaves",
      "type": "backend",
      "label": "SQL Writers",
      "sublabel": "objsave, pets",
      "stage": 1,
      "row": 2
    },
    {
      "id": "worldfiles",
      "type": "database",
      "label": "lib/world",
      "sublabel": "zon, wld, mob, obj",
      "stage": 2,
      "row": 0
    },
    {
      "id": "pfiles",
      "type": "database",
      "label": "lib/plrfiles",
      "sublabel": "one per character",
      "stage": 2,
      "row": 1
    },
    {
      "id": "mariadb",
      "type": "database",
      "label": "MariaDB",
      "sublabel": "accounts, items",
      "stage": 2,
      "row": 2,
      "brand": "mariadb"
    },
    {
      "id": "indexboot",
      "type": "backend",
      "label": "index_boot()",
      "sublabel": "db.c",
      "stage": 3,
      "row": 0
    },
    {
      "id": "loaders",
      "type": "security",
      "label": "Login Loaders",
      "sublabel": "account + char",
      "stage": 3,
      "row": 1
    },
    {
      "id": "nextboot",
      "type": "backend",
      "label": "Next Boot",
      "sublabel": "boot_db()",
      "stage": 4,
      "row": 0
    },
    {
      "id": "nextlogin",
      "type": "frontend",
      "label": "Next Login",
      "sublabel": "nanny()",
      "stage": 4,
      "row": 1
    }
