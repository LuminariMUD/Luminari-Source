        "id": "interpret",
        "label": "Interpret and dispatch",
        "focus": [
          "comm",
          "interp",
          "triggers",
          "acmd"
        ],
        "note": "command_interpreter() offers the line to DG command triggers before it looks up cmd_info[] and calls the handler."
      },
      {
        "id": "typed-facts",
        "label": "Typed facts",
        "focus": [
          "acmd",
          "bus"
        ],
        "note": "A committed state change can publish a typed fact; subscribers run inline and return before the handler continues."
      },
      {
        "id": "respond",
        "label": "Respond",
        "focus": [
          "acmd",
          "comm",
          "protocol",
          "client"
        ],
        "note": "Handlers only queue text; process_output() encodes and writes it when the socket is writable."
      }
