          "dispatching",
          "completed"
        ],
        "note": "An admitted event waits on the timing wheel, becomes ready at its deadline, runs once, and is finalized."
      },
      {
        "id": "recurring",
        "label": "Recurring work",
        "focus": [
          "queued",
          "ready",
          "dispatching"
        ],
        "note": "A callback that returns RESCHEDULE puts the same event back on the wheel instead of allocating a new one."
      },
      {
        "id": "cancellation",
        "label": "Cancellation",
        "focus": [
          "queued",
          "dispatching",
          "cancelpending",
          "cancelled"
        ],
        "note": "Cancelling a queued event finalizes it at once; cancelling a running callback waits for it to return."
      },
      {
        "id": "failure",
        "label": "Failure",
        "focus": [
          "dispatching",
          "failed"
        ],
        "note": "A FAILED result, or a reschedule the scheduler cannot place, finalizes the event as FAILED."
      }
