    "views": [
      {
        "id": "command-path",
        "label": "Command path",
        "focus": [
          "clients",
          "network",
          "loop",
          "interp",
          "systems",
          "world"
        ],
        "note": "Follow one typed command from the socket, through the interpreter, to a change in the in-memory world."
      },
      {
        "id": "login-path",
        "label": "Login and accounts",
        "focus": [
          "clients",
          "network",
          "loop",
          "nanny",
          "mariadb"
        ],
        "note": "Until a descriptor reaches CON_PLAYING, every line goes to nanny(), which loads and saves accounts in MariaDB."
      },
      {
        "id": "scheduled-work",
        "label": "Scheduled work",
        "focus": [
          "loop",
          "events",
          "systems"
        ],
        "note": "The loop sleeps until the nearest real deadline, then dispatches a bounded batch of owner callbacks."
      },
      {
        "id": "content-behavior",
        "label": "Scripts and specials",
        "focus": [
          "interp",
          "scripts",
          "systems"
        ],
        "note": "DG command triggers and special procedures get the first look at a command before its ACMD handler runs."
      },
      {
        "id": "persistence",
        "label": "Where state lives",
        "focus": [
          "systems",
          "world",
          "files",
          "mariadb",
          "bridges"
        ],
        "note": "Authored world files feed boot; MariaDB and player files keep what changes while the game runs."
      }
    ]
  },
