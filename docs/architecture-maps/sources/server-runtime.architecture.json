  "cards": [
    {
      "dot": "cyan",
      "title": "One thread owns the game",
      "items": [
        "game_loop() waits on the reactor, then drains input, commands, output, and due events",
        "Commands run immediately; timed work lives on a 5-level, 64-slot timing wheel",
        "Bridge sockets and the AI result pipe reach the loop only as watched descriptors"
      ]
    },
    {
      "dot": "emerald",
      "title": "Where state lives",
      "items": [
        "Authored world: lib/world flat files, loaded by index_boot() at boot",
        "Accounts, help, regions, pets, and object saves: MariaDB through a pooled client",
        "Characters: lib/plrfiles, written by save_char_checked()"
      ]
    },
    {
      "dot": "violet",
      "title": "Revision-pinned evidence",
      "items": [
