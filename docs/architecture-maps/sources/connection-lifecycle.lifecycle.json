{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Player Connection Lifecycle",
    "locale": "en",
    "viewBox": [
      1060,
      650
    ],
    "animation": "trace",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "login-to-play",
        "label": "Login to play",
        "focus": [
          "protocol",
          "account",
          "acctmenu",
          "mainmenu",
          "playing"
        ],
        "note": "A new socket negotiates protocols, authenticates an account, picks a character, and enters the world."
      },
      {
        "id": "new-characters",
        "label": "New characters",
        "focus": [
          "acctmenu",
          "creation",
          "mainmenu"
        ],
        "note": "Character creation is a chain of nanny() states that returns to the main menu when it finishes."
      },
      {
        "id": "link-loss",
        "label": "Link loss",
        "focus": [
          "playing",
          "linkless"
        ],
        "note": "A dropped link saves the character and leaves it in the world until the player logs in again."
      },
      {
        "id": "exits",
        "label": "Exits",
        "focus": [
          "account",
          "closed"
        ],
        "note": "Rejected logins end in CON_CLOSE and the socket is released."
      }
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "Connection phases"
    },
    {
      "id": "side",
      "label": "Creation + link loss"
    },
    {
      "id": "terminal",
      "label": "Terminal exit"
    }
  ],
  "states": [
    {
      "id": "protocol",
      "type": "start",
      "label": "Protocol Probe",
      "sublabel": "CON_GET_PROTOCOL",
      "lane": "main",
      "col": 0,
      "step": "01"
    },
    {
      "id": "account",
      "type": "active",
      "label": "Account Login",
      "sublabel": "CON_ACCOUNT_NAME",
      "lane": "main",
      "col": 1,
      "step": "02"
    },
    {
      "id": "acctmenu",
      "type": "decision",
      "label": "Account Menu",
      "sublabel": "CON_ACCOUNT_MENU",
      "lane": "main",
      "col": 2,
      "step": "03"
    },
    {
      "id": "mainmenu",
      "type": "active",
      "label": "Main Menu",
      "sublabel": "CON_RMOTD, CON_MENU",
      "lane": "main",
      "col": 3,
      "step": "04"
    },
    {
      "id": "playing",
      "type": "success",
      "label": "Playing",
      "sublabel": "CON_PLAYING",
      "lane": "main",
      "col": 4,
      "step": "05"
