  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Main path",
      "items": [
        "Starts in CON_GET_PROTOCOL",
        "nanny() owns all non-playing states",
        "Main menu 1 enters CON_PLAYING"
      ]
    },
    {
      "dot": "rose",
      "title": "Leaving and returning",
      "items": [
        "close_socket() leaves chars linkless",
        "Relogin reattaches via RECON",
        "Rejected logins end in CON_CLOSE"
      ]
    },
    {
      "dot": "violet",
      "title": "Evidence",
      "items": [
        "structs.h: CON_* at 1629-1726",
        "interpreter.c: nanny() at 7868",
        "comm.c: close_socket() at 4331"
      ]
    }
