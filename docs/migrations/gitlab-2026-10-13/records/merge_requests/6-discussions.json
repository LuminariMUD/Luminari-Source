  {
    "id": "abc6f7a77baaa6da72a4290363b92074ba2b77df",
    "individual_note": false,
    "resolvable": true,
    "resolved": true,
    "notes": [
      {
        "id": 3918198987,
        "type": "DiffNote",
        "body": "[P1] Routine departure checks run DDL on the game loop. `vessel_ship_min_level()` calls this function for every prototype-backed hull, so each `setsail`, `autopilot on`, `assignpilot`, and `setschedule` executes both `CREATE TABLE IF NOT EXISTS` and `ALTER TABLE ship_prototypes ADD COLUMN IF NOT EXISTS`. MariaDB queues `ALTER TABLE` behind a metadata lock held by another transaction (https://mariadb.com/docs/server/reference/sql-statements/transactions/metadata-locking); one blocked helm command can therefore stall the single-threaded MUD until that transaction ends. Run schema creation/migration at boot or deployment only, and make the command path a read of the already-migrated level.",
        "author": {
          "id": 42759441,
          "username": "max757",
          "public_email": "",
          "name": "Max aka Mosheh",
          "state": "active",
          "locked": false,
          "avatar_url": "https://secure.gravatar.com/avatar/3c7c169343bd7d0f4575137ce8065aee7cb44024d447bbfe66d773133a81c43e?s=80&d=identicon",
          "web_url": "https://gitlab.com/max757"
        },
