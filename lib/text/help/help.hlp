ALIGNMENT-VALUES

  if (align >= 800)
return LAWFUL_GOOD;
  if (align >= 575 && align < 800)
return NEUTRAL_GOOD;
  if (align >= 350 && align < 575)
return CHAOTIC_GOOD;
  if (align >= 125 && align < 350)
return LAWFUL_NEUTRAL;
  if (align < 125 && align > -125)
return TRUE_NEUTRAL;
  if (align <= -125 && align > -350)
return CHAOTIC_NEUTRAL;
  if (align <= -350 && align > -575)
return LAWFUL_EVIL;
  if (align <= -575 && align > -800)
return NEUTRAL_EVIL;
  if (align <= -800)
return CHAOTIC_EVIL

See Also:  ALIGNMENT

